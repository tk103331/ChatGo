{
  "id": "agent-importers",
  "name": "Agent 配置导入",
  "version": "1.0.0",
  "author": "ChatGo",
  "description": "从其他编程 Agent 的本地配置导入 Skills、MCP 服务器与模型 Provider（Claude Code、OpenCode、Codex、Cursor、Gemini CLI）",
  "importers": [
    {
      "id": "claude-code-skills",
      "label": "Claude Code",
      "kinds": [
        "skills"
      ],
      "dirs": [
        "~/.claude/skills"
      ]
    },
    {
      "id": "opencode-skills",
      "label": "OpenCode",
      "kinds": [
        "skills"
      ],
      "dirs": [
        "~/.opencode/skill",
        "~/.opencode/skills"
      ]
    },
    {
      "id": "codex-skills",
      "label": "Codex",
      "kinds": [
        "skills"
      ],
      "dirs": [
        "~/.codex/skills",
        "~/.codex/skill"
      ]
    },
    {
      "id": "agents-shared-skills",
      "label": "Agents (共享)",
      "kinds": [
        "skills"
      ],
      "dirs": [
        "~/.agents/skills"
      ]
    },
    {
      "id": "claude-code",
      "label": "Claude Code",
      "kinds": [
        "mcp",
        "providers"
      ],
      "files": [
        {
          "path": "~/.claude.json"
        },
        {
          "path": "~/.claude/settings.json"
        },
        {
          "path": "~/.claude/settings.local.json"
        },
        {
          "path": ".mcp.json"
        }
      ],
      "format": "json",
      "mapping": {
        "mcp": {
          "root": "/mcpServers",
          "name": "@key",
          "type": "type",
          "command": "command",
          "args": "args",
          "env": "env",
          "url": "url",
          "headers": "headers"
        },
        "providers": {
          "root": "/customApiKeyResponses",
          "name": "@key"
        }
      }
    },
    {
      "id": "opencode",
      "label": "OpenCode",
      "kinds": [
        "mcp",
        "providers"
      ],
      "files": [
        {
          "path": "~/.config/opencode/opencode.json"
        },
        {
          "path": "~/.opencode/opencode.json"
        },
        {
          "path": "opencode.json"
        }
      ],
      "format": "json",
      "mapping": {
        "mcp": {
          "root": "/mcp",
          "name": "@key",
          "type": "type",
          "command": "command",
          "args": "command",
          "env": "environment",
          "url": "url",
          "headers": "headers"
        },
        "providers": {
          "root": "/provider",
          "name": "@key",
          "baseURL": "/options/baseURL",
          "apiKey": "/options/apiKey",
          "models": "/models"
        }
      }
    },
    {
      "id": "codex",
      "label": "Codex",
      "kinds": [
        "mcp",
        "providers"
      ],
      "files": [
        {
          "path": "~/.codex/config.toml"
        }
      ],
      "format": "toml",
      "mapping": {
        "mcp": {
          "root": "/mcp_servers",
          "name": "@key",
          "command": "command",
          "args": "args",
          "env": "env"
        },
        "providers": {
          "root": "/model_providers",
          "name": "@key",
          "baseURL": "base_url",
          "apiKey": "env_key"
        }
      }
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "kinds": [
        "mcp"
      ],
      "files": [
        {
          "path": "~/.cursor/mcp.json"
        },
        {
          "path": ".cursor/mcp.json"
        }
      ],
      "format": "json",
      "mapping": {
        "mcp": {
          "root": "/mcpServers",
          "name": "@key",
          "command": "command",
          "args": "args",
          "env": "env",
          "url": "url",
          "headers": "headers"
        }
      }
    },
    {
      "id": "gemini-cli",
      "label": "Gemini CLI",
      "kinds": [
        "mcp"
      ],
      "files": [
        {
          "path": "~/.gemini/settings.json"
        }
      ],
      "format": "json",
      "mapping": {
        "mcp": {
          "root": "/mcpServers",
          "name": "@key",
          "command": "command",
          "args": "args",
          "env": "env",
          "url": "url",
          "headers": "headers"
        }
      }
    }
  ]
}

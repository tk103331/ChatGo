{
  "id": "acp-catalog-mainstream",
  "name": "ACP 主流 Agent 目录",
  "version": "1.0.0",
  "author": "ChatGo",
  "description": "主流 ACP 编程 Agent 的预置目录（Claude Code、Codex、Gemini CLI、Cline 等）",
  "catalog": [
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "ClaudeCode",
      "command": "npx",
      "args": [
        "-y",
        "@zed-industries/claude-code-acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "ClaudeAgentSDK",
      "command": "npx",
      "args": [
        "-y",
        "@zed-industries/claude-agent-acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "OpenCode",
      "command": "opencode",
      "args": [
        "acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "CodexCLI",
      "command": "npx",
      "args": [
        "-y",
        "@agentclientprotocol/codex-acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "Cursor",
      "command": "cursor-agent",
      "args": [
        "acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "GeminiCLI",
      "command": "gemini",
      "args": [
        "--acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "QwenCode",
      "command": "qwen",
      "args": [
        "--acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "Cline",
      "command": "npx",
      "args": [
        "-y",
        "cline",
        "--acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "KimiCLI",
      "command": "kimi",
      "args": [
        "acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "Goose",
      "command": "goose",
      "args": [
        "acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "KiroCLI",
      "command": "kiro-cli",
      "args": [
        "acp"
      ]
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "GitHubCopilot",
      "command": "copilot"
    },
    {
      "kind": "acp",
      "group": "主流 Agent",
      "name": "AugmentCode",
      "command": "npx",
      "args": [
        "-y",
        "@augmentcode/auggie",
        "--acp"
      ],
      "env": {
        "AUGMENT_DISABLE_AUTO_UPDATE": "1"
      }
    }
  ]
}
